# FocusLoop Backend Environment Variables

# Application Settings
PROJECT_NAME="FocusLoop API"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Settings
# Primary: PostgreSQL (production/staging/docker or local PostgreSQL):
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/focusloop"
# Or with standard URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusloop"
# Fallback / local zero-config testing:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/focusloop"

# AI / LLM Configuration
# Optional: Set your Gemini API key to enable live AI behavioral explanations & micro-experiments.
# If omitted, FocusLoop gracefully runs with deterministic mock/fallback behavioral insights.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="*"
